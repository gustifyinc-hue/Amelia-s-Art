# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local — it holds secrets.

# Stripe (https://dashboard.stripe.com/apikeys)
# Use the TEST secret key (sk_test_...) while developing, then the LIVE key (sk_live_...) when going live.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe webhook signing secret (whsec_...).
# Get this from `stripe listen` locally, or from the Dashboard webhook endpoint once deployed.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# CJ Dropshipping API (https://developers.cjdropshipping.com)
# CJ_EMAIL is your CJ account login email; CJ_API_KEY is generated in the Developer section.
CJ_EMAIL=you@example.com
CJ_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL of the deployed site (used for Stripe success/cancel redirects).
# Locally this is http://localhost:3000 ; in production set to your real domain.
PUBLIC_BASE_URL=http://localhost:3000
